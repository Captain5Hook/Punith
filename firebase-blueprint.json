{
  "entities": {
    "DonorProfile": {
      "title": "DonorProfile",
      "description": "Private donor profile, blood type, availability status, and donation eligibility details owned by a single user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bloodType": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "available": {
          "type": "boolean"
        },
        "lastDonationDate": {
          "type": "string",
          "maxLength": 10
        },
        "donationsCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "bloodType",
        "city",
        "available",
        "lastDonationDate",
        "donationsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "DonationLog": {
      "title": "DonationLog",
      "description": "Personal blood donation history entry stored under the donor's private profile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "centerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bloodType": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "volumeMl": {
          "type": "number"
        },
        "donatedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "centerName",
        "city",
        "bloodType",
        "volumeMl",
        "donatedDate",
        "notes",
        "createdAt"
      ]
    },
    "BloodRequest": {
      "title": "BloodRequest",
      "description": "Community blood request posted by an authenticated requester without exposing personal contact PII.",
      "type": "object",
      "properties": {
        "requesterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requesterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "patientLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bloodType": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "unitsNeeded": {
          "type": "number"
        },
        "unitsPledged": {
          "type": "number"
        },
        "hospitalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "urgency": {
          "type": "string",
          "enum": ["critical", "urgent", "scheduled"]
        },
        "notes": {
          "type": "string",
          "maxLength": 280
        },
        "status": {
          "type": "string",
          "enum": ["open", "fulfilled", "cancelled"]
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requesterId",
        "requesterName",
        "patientLabel",
        "bloodType",
        "unitsNeeded",
        "unitsPledged",
        "hospitalName",
        "city",
        "urgency",
        "notes",
        "status",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "RequestPledge": {
      "title": "RequestPledge",
      "description": "Donor commitment pledged toward an open blood request.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requesterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "donorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "donorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bloodType": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "status": {
          "type": "string",
          "enum": ["pledged", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestId",
        "requesterId",
        "donorId",
        "donorName",
        "bloodType",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/donors/{userId}": {
      "schema": { "$ref": "#/entities/DonorProfile" },
      "description": "Private donor profile and eligibility record owned by userId."
    },
    "/donors/{userId}/donations/{donationId}": {
      "schema": { "$ref": "#/entities/DonationLog" },
      "description": "Personal blood donation history records owned by userId."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/BloodRequest" },
      "description": "Community blood requests posted by authenticated users."
    },
    "/requests/{requestId}/pledges/{pledgeId}": {
      "schema": { "$ref": "#/entities/RequestPledge" },
      "description": "Donor pledges linked to a specific blood request."
    }
  }
}
