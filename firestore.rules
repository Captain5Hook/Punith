rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Validation Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBloodType(bt) {
      return bt in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    // --- Entity Validation Blueprints ---
    function isValidDonorProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'bloodType', 'city',
          'available', 'lastDonationDate', 'donationsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'bloodType', 'city',
          'available', 'lastDonationDate', 'donationsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && isValidBloodType(data.bloodType)
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.available is bool
        && data.lastDonationDate is string
        && (data.lastDonationDate == '' || (data.lastDonationDate.size() == 10 && data.lastDonationDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.donationsCount is int && data.donationsCount >= 0 && data.donationsCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDonationLog(data, userId) {
      return data.keys().hasAll([
          'userId', 'centerName', 'city', 'bloodType', 'volumeMl', 'donatedDate', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'centerName', 'city', 'bloodType', 'volumeMl', 'donatedDate', 'notes', 'createdAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.centerName is string && data.centerName.size() >= 1 && data.centerName.size() <= 100
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && isValidBloodType(data.bloodType)
        && data.volumeMl is int && data.volumeMl >= 100 && data.volumeMl <= 600
        && data.donatedDate is string && data.donatedDate.size() == 10 && data.donatedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.notes is string && data.notes.size() <= 240
        && data.createdAt is timestamp;
    }

    function isValidBloodRequest(data) {
      return data.keys().hasAll([
          'requesterId', 'requesterName', 'patientLabel', 'bloodType',
          'unitsNeeded', 'unitsPledged', 'hospitalName', 'city',
          'urgency', 'notes', 'status', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requesterId', 'requesterName', 'patientLabel', 'bloodType',
          'unitsNeeded', 'unitsPledged', 'hospitalName', 'city',
          'urgency', 'notes', 'status', 'isPublic', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requesterId)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80
        && data.patientLabel is string && data.patientLabel.size() >= 1 && data.patientLabel.size() <= 80
        && isValidBloodType(data.bloodType)
        && data.unitsNeeded is int && data.unitsNeeded >= 1 && data.unitsNeeded <= 10
        && data.unitsPledged is int && data.unitsPledged >= 0 && data.unitsPledged <= data.unitsNeeded
        && data.hospitalName is string && data.hospitalName.size() >= 1 && data.hospitalName.size() <= 120
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.urgency in ['critical', 'urgent', 'scheduled']
        && data.notes is string && data.notes.size() <= 280
        && data.status in ['open', 'fulfilled', 'cancelled']
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRequestPledge(data, requestId, pledgeId) {
      return data.keys().hasAll([
          'requestId', 'requesterId', 'donorId', 'donorName', 'bloodType', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'requesterId', 'donorId', 'donorName', 'bloodType', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requestId)
        && data.requestId == requestId
        && isValidId(data.requesterId)
        && isValidId(data.donorId)
        && data.donorId == pledgeId
        && data.donorName is string && data.donorName.size() >= 1 && data.donorName.size() <= 80
        && isValidBloodType(data.bloodType)
        && data.status in ['pledged', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Device-Scoped Donor Profiles & Donation History (No PII, no blanket list) ---
    match /donors/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isValidDonorProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidDonorProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'bloodType', 'city', 'available',
          'lastDonationDate', 'donationsCount', 'updatedAt'
        ]);

      allow delete: if false;

      match /donations/{donationId} {
        allow get: if isValidId(userId) && isValidId(donationId);
        allow list: if isValidId(userId) && resource.data.userId == userId;

        allow create: if isValidId(userId)
          && isValidId(donationId)
          && isValidDonationLog(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/donors/$(userId));

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(donationId);
      }
    }

    // --- Community Blood Requests ---
    match /requests/{requestId} {
      allow get: if isValidId(requestId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;

      allow create: if isValidId(requestId)
        && isValidBloodRequest(incoming())
        && incoming().unitsPledged == 0
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isValidBloodRequest(incoming())
        && existing().status == 'open'
        && incoming().requesterId == existing().requesterId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Status or detail update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'patientLabel', 'unitsNeeded', 'hospitalName', 'city', 'urgency', 'notes', 'status', 'isPublic', 'updatedAt'
          ])
          ||
          // Action 2: Donor atomically pledges 1 unit (requires pledge doc created in same batch)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['unitsPledged', 'status', 'updatedAt'])
            && incoming().unitsPledged == existing().unitsPledged + 1
            && (
              (incoming().unitsPledged >= incoming().unitsNeeded && incoming().status == 'fulfilled')
              || (incoming().unitsPledged < incoming().unitsNeeded && incoming().status == 'open')
            )
          )
        );

      allow delete: if false;

      // --- Donor Pledges Subcollection ---
      match /pledges/{pledgeId} {
        allow get: if isValidId(requestId) && isValidId(pledgeId);
        allow list: if isValidId(requestId) && resource.data.requestId == requestId;

        allow create: if isValidId(requestId)
          && isValidId(pledgeId)
          && isValidRequestPledge(incoming(), requestId, pledgeId)
          && incoming().status == 'pledged'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/requests/$(requestId))
          && get(/databases/$(database)/documents/requests/$(requestId)).data.status == 'open'
          && incoming().requesterId == get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.unitsPledged
             == get(/databases/$(database)/documents/requests/$(requestId)).data.unitsPledged + 1;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
